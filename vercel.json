{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?__path=/" },
    { "source": "/mining", "destination": "/api/index?__path=/mining" },
    { "source": "/arbitrage", "destination": "/api/index?__path=/arbitrage" },
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/evm/:path*", "destination": "/api/index?__path=/evm/:path*" },
    { "source": "/cosmos/:path*", "destination": "/api/index?__path=/cosmos/:path*" },
    { "source": "/substrate/:path*", "destination": "/api/index?__path=/substrate/:path*" },
    { "source": "/major/:path*", "destination": "/api/index?__path=/major/:path*" }
  ]
}
